# Database (Neon/Postgres) untuk auth pelanggan & data aplikasi
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# NextAuth/Auth.js (wajib di production/Vercel)
AUTH_SECRET="ganti-dengan-secret-acak-panjang"
# Opsional, biasanya otomatis terdeteksi di Vercel
# AUTH_URL="https://your-app.vercel.app"

# PIN rahasia untuk masuk ke area pegawai (/pegawai)
STAFF_PIN=""
# Opsional: secret sesi pegawai terpisah
# STAFF_SESSION_SECRET=""

# Opsional: API key Gemini (jika fitur AI digunakan)
# GEMINI_API_KEY=""
# APP_URL="https://your-app.vercel.app"
